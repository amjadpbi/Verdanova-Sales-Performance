table sales
	lineageTag: 1a294a63-a20c-41ca-be22-10c636130b4e
	sourceLineageTag: [dbo].[sales]

	measure 'Total Sales' =
			
			SUM('sales'[LineAmount])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 25fdf305-ae75-47ba-b347-772d0c745bd3

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total Orders' =
			
			DISTINCTCOUNT('sales'[OrderID])
		formatString: 0
		lineageTag: cc70b9d3-a6ff-4087-98ee-7549b9a958b3

		changedProperty = Name

	measure Profit =
			
			SUMX(
			    'sales',
			    'sales'[LineAmount] - ('sales'[Quantity] * 'sales'[CostAtSale])
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 34babbe2-04c9-4bd7-89fa-f35f5caf4166

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Previous Period Sales' =
			
			CALCULATE(
			    [Total Sales],
			    DATEADD('calendar'[Date], -1, MONTH)
			)
		lineageTag: a82fdc00-c3c9-4d60-9313-dfdb6f4c8b98

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Growth %' =
			
			DIVIDE(
			    [Total Sales] - [Previous Period Sales],
			    [Previous Period Sales]
			)
		lineageTag: 9b53daca-c6f3-4fb6-8c49-74d498b0445d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Sales Rank' =
			
			RANKX(
			    ALL('products'[ProductName]),
			    [Total Sales],
			    ,
			    DESC,
			    Dense
			)
		formatString: 0
		lineageTag: 6f4066e1-14bc-4b09-ae24-6c010be752ab

		changedProperty = Name

	measure 'Contribution %' =
			
			DIVIDE(
			    [Total Sales],
			    CALCULATE(
			        [Total Sales],
			        ALLSELECTED('products'[ProductName])
			    )
			)
		lineageTag: 5c88bf91-9fd3-4796-8f88-92bbce466db5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

