table salestarget
	lineageTag: 5869a236-36ee-406b-87d5-390d4d215846
	sourceLineageTag: [dbo].[salestarget]

	measure 'Sales Target' =
			
			CALCULATE(
			    SUM('salestarget'[SalesTarget]),
			    TREATAS(
			        VALUES('calendar'[YearMonthKey]),
			        'salestarget'[YearMonthKey]
			    ),
			    TREATAS(
			        VALUES('regions'[Region]),
			        'salestarget'[Region]
			    ),
			    TREATAS(
			        VALUES('category'[Category]),
			        'salestarget'[ProductCategory]
			    )
			)
		lineageTag: 75098625-2cef-46cb-9dee-797501514b00

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Variance' =
			
			[Total Sales] - [Sales Target]
		lineageTag: 6315fbe5-5766-4451-907f-f997c28646a2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Achievement %' =
			
			DIVIDE(
			    [Total Sales],
			    [Sales Target]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bc3e3b20-95b1-4d91-add6-73d96e90d781

		changedProperty = Name

		changedProperty = FormatString

	column TargetID
		dataType: string
		lineageTag: 835ff7f9-228f-49c2-aa0e-51a0ae863952
		sourceLineageTag: TargetID
		summarizeBy: none
		sourceColumn: TargetID

		annotation SummarizationSetBy = Automatic

	column Year
