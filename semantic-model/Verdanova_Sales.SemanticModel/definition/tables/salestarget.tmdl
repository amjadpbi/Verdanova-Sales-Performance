		formatString: 0
		lineageTag: 4ad04c40-1cd4-45d1-a736-927f0cbec448
		sourceLineageTag: Month
		summarizeBy: sum
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		lineageTag: 7fafc761-e834-440d-972e-b1bd8522d3a4
		sourceLineageTag: Region
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column ProductCategory
		dataType: string
		lineageTag: cc0f7a21-7258-4041-8525-21f4e7fe9d6e
